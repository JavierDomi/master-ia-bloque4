# Copia este fichero como .env y NO lo subas nunca al repositorio (añádelo a .gitignore).
#
# Configuración del curso: OpenRouter. Crea una clave en https://openrouter.ai/ (Keys)
# y pégala SOLO en la línea siguiente; las demás la reutilizan.
OPENROUTER_API_KEY=sk-or-...

# "OpenAI": SDK de OpenAI (Responses API) contra OpenRouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=${OPENROUTER_API_KEY}
OPENAI_MODEL=openai/gpt-5.4-mini

# "Claude": SDK de Anthropic (Messages API) contra OpenRouter
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=${OPENROUTER_API_KEY}
ANTHROPIC_MODEL=anthropic/claude-haiku-4.5

# "Gemini": vía OpenRouter con Chat Completions (SDK de OpenAI)
GEMINI_MODEL=google/gemini-3.8-flash

# Opcional: Gemini con su API nativa (Interactions API, SDK google-genai).
# Si pegas aquí una clave gratuita de https://aistudio.google.com/, los scripts usan
# la API nativa de Gemini en lugar de OpenRouter (el prefijo google/ se quita solo).
# En el plan gratuito gemini-3.8-flash suele estar saturado (error 503): con clave nativa,
# usa GEMINI_MODEL=google/gemini-3.5-flash-lite.
GEMINI_API_KEY=

# ¿Quieres gastar menos? Modelos más baratos en OpenRouter: openai/gpt-5.4-nano,
# google/gemini-3.5-flash-lite o deepseek/deepseek-v4-flash (vale en cualquier hueco).
# ¿Tienes claves propias de OpenAI o Anthropic? Borra la línea ..._BASE_URL, pon tu
# clave en ..._API_KEY y el modelo sin prefijo (por ejemplo gpt-5.4-mini o claude-haiku-4-5).
